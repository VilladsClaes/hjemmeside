@page
@using Crafts.Components
@model IndexModel
@{
    ViewData["Title"] = "Samtalen";
}


@* Indsæt blogindlægsoverblik *@
@(await Html.RenderComponentAsync<BlogindlaegListe>(RenderMode.ServerPrerendered))

<div class="card-columns">
    @foreach (var forkortelse in Model.Forkortelser)
    {
        <div class="card">
            <div class="card-img" style="background-image: url('@forkortelse.Forkortes');"></div>
            <div class="card-body">
                <h5 class="card-title">@forkortelse.Oprindelse</h5>
            </div>
        </div>
    }
</div>


@* Brug af BLazorkomponenter *@
<script src="_framework/blazor.server.js"></script>