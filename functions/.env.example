# Kopiér denne fil til ".env" i "functions/"-mappen og udfyld dine egne værdier.
# ".env" bliver ALDRIG committet (se .gitignore) og læses automatisk af
# Cloud Functions (2nd gen) via firebase-functions/params.
#
# Hemmelige værdier (klient-secrets, krypteringsnøgle) bør i stedet sættes som
# "secrets" med Firebase CLI, så de ikke ligger i klartekst nogen steder:
#   firebase functions:secrets:set MS_CLIENT_SECRET
#   firebase functions:secrets:set TOKEN_ENCRYPTION_KEY
# De ikke-hemmelige værdier herunder kan bare stå i .env.

# E-mailadressen på den Firebase Auth-konto, der må godkende/afvise opgaver
# og forbinde Microsoft To Do / Google Tasks. Skal matche den konto du logger
# ind med på opgaveliste-admin.html.
OWNER_EMAIL=dig@example.com

# Hvilken udbyder der aktivt synkroniseres med: "microsoft" (primær, anbefalet)
# eller "google" (fallback, hvis Microsoft-opsætningen ikke kan lade sig gøre).
ACTIVE_PROVIDER=microsoft

# --- Microsoft Graph / Microsoft To Do ---
# Fra din Azure AD app-registrering (se README).
MS_CLIENT_ID=
# MS_CLIENT_SECRET sættes som secret, ikke her (se kommentar øverst).
# "consumers" for private Microsoft-konti, "common" hvis du også vil tillade
# arbejds-/skolekonti.
MS_TENANT=consumers
# Skal matche den redirect-URI du har registreret i Azure AD, typisk:
# https://REGION-PROJEKT.cloudfunctions.net/msOauthCallback
MS_REDIRECT_URI=
# Navnet på den dedikerede liste i Microsoft To Do, som bruges til hjemmesidens
# opgaver (oprettes automatisk første gang, hvis den ikke findes).
MS_LIST_NAME=Fra hjemmesiden

# --- Google Tasks (kun hvis ACTIVE_PROVIDER=google) ---
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET sættes som secret, ikke her.
GOOGLE_REDIRECT_URI=
GOOGLE_LIST_TITLE=Fra hjemmesiden

# TOKEN_ENCRYPTION_KEY sættes som secret, ikke her: en tilfældig 32-byte hex-
# streng til AES-256-GCM-kryptering af de gemte refresh tokens. Generér fx med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
