rules_version = '2';

// Sikkerhedsregler til den delte, offentlige opgaveliste.
//
// - "tasks": de godkendte opgaver. Alle må læse. Ingen må skrive direkte —
//   det sker udelukkende via Cloud Functions (Admin SDK), som ikke er
//   underlagt disse regler. Det sikrer at hver opgave altid følges af den
//   tilhørende synkronisering til Microsoft To Do / Google Tasks.
// - "pendingSubmissions" / "pendingClaims": besøgende må oprette (foreslå).
//   Kun ejeren må opdatere eller slette (dvs. godkende/afvise). Læsning er
//   tilladt for ejeren, samt for en logget-ind bruger, der læser sit eget
//   forslag (matchet på et valgfrit "uid"-felt sat ved oprettelse, når
//   brugeren har en konto — se "Rigtig kodeordstjek"-funktionen).
// - "config": interne, krypterede tokens m.m. til Cloud Functions. Aldrig
//   tilgængelig for klienten, hverken læsning eller skrivning.
//
// VIGTIGT: Udskift OWNER_UID nedenfor med din egen Firebase Auth UID, når du
// har oprettet din ejer-konto (se README.md, afsnittet "Opsætning af den
// delte opgaveliste"). Du finder UID'et under Firebase-konsollen ->
// Authentication -> Users, efter du har logget ind én gang på
// opgaveliste-admin.html.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.uid == "OWNER_UID_PLACEHOLDER";
    }

    function isNonEmptyShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalShortString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    // Et valgfrit "uid"-felt må kun være enten fraværende/null (anonym
    // indsendelse) eller den afsendende brugers egen uid — aldrig en andens.
    function isOwnOptionalUid(value) {
      return value == null || (request.auth != null && value == request.auth.uid);
    }

    // Den logget-ind bruger, der selv oprettede dokumentet (matchet på uid).
    function isSubmitter(resourceData) {
      return request.auth != null
        && resourceData.uid != null
        && resourceData.uid == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow write: if false; // kun Cloud Functions (Admin SDK) må skrive
    }

    match /pendingSubmissions/{submissionId} {
      allow read: if isOwner() || isSubmitter(resource.data);
      allow update, delete: if isOwner();
      allow create: if
        isNonEmptyShortString(request.resource.data.title, 160) &&
        isOptionalShortString(request.resource.data.description, 2000) &&
        isOptionalShortString(request.resource.data.contactName, 120) &&
        isOptionalShortString(request.resource.data.contactEmail, 200) &&
        isOwnOptionalUid(request.resource.data.uid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'contactName', 'contactEmail',
          'status', 'createdAt', 'uid'
        ]);
    }

    match /pendingClaims/{claimId} {
      allow read: if isOwner() || isSubmitter(resource.data);
      allow update, delete: if isOwner();
      allow create: if
        request.resource.data.taskId is string &&
        exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)) &&
        isNonEmptyShortString(request.resource.data.claimantName, 120) &&
        isOptionalShortString(request.resource.data.claimantContact, 200) &&
        isOwnOptionalUid(request.resource.data.uid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'taskId', 'claimantName', 'claimantContact', 'status', 'createdAt', 'uid'
        ]);
    }

    // Krypterede provider-tokens og synkroniserings-state. Kun Admin SDK
    // (Cloud Functions) kan læse/skrive — ingen klientadgang overhovedet.
    match /config/{document=**} {
      allow read, write: if false;
    }

    // Villads' seneste GPS-position (fra OwnTracks, via Cloud Function
    // "reportLocation"). Må ALDRIG være læsbar eller skrivbar fra klienten —
    // kun Cloud Functions (Admin SDK) må tilgå den. Afstanden til en
    // besøgende beregnes udelukkende server-side af "getDistanceToVisitor",
    // som kun returnerer selve afstanden, aldrig koordinaterne.
    match /location/{document=**} {
      allow read, write: if false;
    }

    // "pendingQuotes" / "quotes": den delte citatmaskine på legeplads.html
    // (eksperiment #92). Besøgende må foreslå citater; kun ejeren må
    // godkende/afvise (via opgaveliste-admin.html). "quotes" er de godkendte
    // citater, som alle må læse, men kun Cloud Functions (Admin SDK) må
    // skrive til — præcis samme mønster som "pendingSubmissions"/"tasks".
    match /pendingQuotes/{quoteId} {
      allow read: if isOwner() || isSubmitter(resource.data);
      allow update, delete: if isOwner();
      allow create: if
        isNonEmptyShortString(request.resource.data.text, 280) &&
        isOptionalShortString(request.resource.data.author, 80) &&
        isOwnOptionalUid(request.resource.data.uid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'text', 'author', 'status', 'createdAt', 'uid'
        ]);
    }

    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if false; // kun Cloud Functions (Admin SDK) må skrive
    }

    // "ratings": delt, anonym vurdering af legepladsens eksperimenter
    // (legeplads.html). Hvert dokument er KUN et aggregeret tal — ingen
    // individuelle stemmer eller uid'er gemmes. Klienten skriver direkte
    // (increment-only), så der er ikke behov for en Cloud Function, men
    // reglerne sikrer at hver skrivning kun kan lægge præcis én stemme
    // (mellem 1 og 5) til summen og tælleren, og at ingen andre felter kan
    // ændres eller forfalskes.
    function isValidRatingVote(value) {
      return value is int && value >= 1 && value <= 5;
    }

    match /ratings/{experimentId} {
      allow read: if true;
      allow delete: if false;

      // Første stemme på et eksperiment opretter dokumentet.
      allow create: if
        request.resource.data.keys().hasOnly(['count', 'sum', 'updatedAt']) &&
        request.resource.data.count == 1 &&
        isValidRatingVote(request.resource.data.sum);

      // Hver efterfølgende stemme må kun lægge præcis 1 til tælleren og
      // mellem 1-5 til summen (den nye stemmes værdi) — intet andet må ændres.
      allow update: if
        request.resource.data.keys().hasOnly(['count', 'sum', 'updatedAt']) &&
        request.resource.data.count == resource.data.count + 1 &&
        isValidRatingVote(request.resource.data.sum - resource.data.sum);
    }
  }
}
